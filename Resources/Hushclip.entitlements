<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store build. Hushclip needs no network, file or device access: it only
	     reads the general pasteboard, stores its vault in its own container, and keeps
	     the key in the Keychain. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
